<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="false"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="1.2"
        android:text="@string/library_intro"
        android:textColor="@color/ink_black"
        android:textSize="@dimen/text_body" />

    <Button
        android:id="@+id/start_import_button"
        style="@style/Widget.EInkWiki.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="48dp"
        android:text="@string/start_lan_import" />

    <TextView
        android:id="@+id/import_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/panel_border"
        android:padding="10dp"
        android:textColor="@color/ink_black"
        android:textIsSelectable="true"
        android:textSize="16sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/import_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/import_waiting"
        android:textColor="@color/ink_black"
        android:textSize="@dimen/text_small"
        android:visibility="gone" />

    <org.einkwiki.app.EInkProgressView
        android:id="@+id/import_progress"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/stop_import_button"
        style="@style/Widget.EInkWiki.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:text="@string/stop_lan_import"
        android:visibility="gone" />
</LinearLayout>
