<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="false"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <Button
            android:id="@+id/back_button"
            style="@style/Widget.EInkWiki.Button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/back"
            android:visibility="gone" />

        <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/ink_black"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <Button
            android:id="@+id/settings_button"
            style="@style/Widget.EInkWiki.Button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/settings" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ink_black" />

    <TextView
        android:id="@+id/message_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/panel_border"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="48dp"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:textColor="@color/ink_black"
        android:textSize="16sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:animateLayoutChanges="false">

        <LinearLayout
            android:id="@+id/home_screen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:padding="24dp">

            <Space
                android:layout_width="match_parent"
                android:layout_height="36dp" />

            <EditText
                android:id="@+id/home_search_input"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/panel_border"
                android:hint="@string/home_search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="@color/ink_black"
                android:textColorHint="@color/ink_gray"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/random_entries_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="@string/random_entries_title"
                    android:textColor="@color/ink_black"
                    android:textSize="@dimen/text_small"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/random_entry_1"
                    style="@style/Widget.EInkWiki.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/random_entry_2"
                    style="@style/Widget.EInkWiki.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/random_entry_3"
                    style="@style/Widget.EInkWiki.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:id="@+id/settings_screen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/offline_library_setting_title"
                    android:textColor="@color/ink_black"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/offline_library_setting_summary"
                    android:textColor="@color/ink_gray"
                    android:textSize="@dimen/text_small" />

                <Button
                    android:id="@+id/open_library_button"
                    style="@style/Widget.EInkWiki.Button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/open_offline_library" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="24dp"
                    android:background="@color/ink_black" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/reader_settings_title"
                    android:textColor="@color/ink_black"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/show_page_buttons_checkbox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:buttonTint="@color/ink_black"
                    android:minHeight="48dp"
                    android:text="@string/show_page_buttons"
                    android:textColor="@color/ink_black"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="36dp"
                    android:paddingEnd="0dp"
                    android:text="@string/show_page_buttons_summary"
                    android:textColor="@color/ink_gray"
                    android:textSize="@dimen/text_small" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/reader_font_size"
                    android:textColor="@color/ink_black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/font_size_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/font_size_small"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:buttonTint="@color/ink_black"
                        android:gravity="center_vertical"
                        android:text="@string/font_size_small"
                        android:textColor="@color/ink_black"
                        android:textSize="16sp" />

                    <RadioButton
                        android:id="@+id/font_size_medium"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:buttonTint="@color/ink_black"
                        android:gravity="center_vertical"
                        android:text="@string/font_size_medium"
                        android:textColor="@color/ink_black"
                        android:textSize="16sp" />

                    <RadioButton
                        android:id="@+id/font_size_large"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:buttonTint="@color/ink_black"
                        android:gravity="center_vertical"
                        android:text="@string/font_size_large"
                        android:textColor="@color/ink_black"
                        android:textSize="16sp" />
                </RadioGroup>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/library_screen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animateLayoutChanges="false"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <ListView
                android:id="@+id/offline_pack_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:cacheColorHint="@color/paper_white"
                android:divider="@color/ink_black"
                android:dividerHeight="1dp"
                android:drawSelectorOnTop="false"
                android:fadeScrollbars="false"
                android:listSelector="@drawable/list_selector"
                android:overScrollMode="never"
                android:scrollbars="vertical"
                android:smoothScrollbar="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/search_screen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animateLayoutChanges="false"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/search_input"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/panel_border"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:importantForAutofill="no"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/ink_black"
                    android:textColorHint="@color/ink_gray"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/search_button"
                    style="@style/Widget.EInkWiki.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:text="@string/search_action" />
            </LinearLayout>

            <TextView
                android:id="@+id/search_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:text="@string/search_empty"
                android:textColor="@color/ink_gray"
                android:textSize="@dimen/text_small" />

            <ListView
                android:id="@+id/search_results"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:cacheColorHint="@color/paper_white"
                android:divider="@color/ink_black"
                android:dividerHeight="1dp"
                android:drawSelectorOnTop="false"
                android:listSelector="@drawable/list_selector"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:smoothScrollbar="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/reader_screen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animateLayoutChanges="false"
            android:orientation="vertical"
            android:visibility="gone">

            <WebView
                android:id="@+id/article_webview"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/paper_white"
                android:fadeScrollbars="false"
                android:overScrollMode="never"
                android:scrollbarStyle="outsideOverlay"
                android:scrollbars="none" />

            <LinearLayout
                android:id="@+id/reader_page_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="6dp">

                <Button
                    android:id="@+id/page_up_button"
                    style="@style/Widget.EInkWiki.Button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/page_up" />

                <Button
                    android:id="@+id/page_down_button"
                    style="@style/Widget.EInkWiki.Button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/page_down" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
