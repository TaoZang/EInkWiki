<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="false"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <Button
            android:id="@+id/back_button"
            style="@style/Widget.EInkWiki.Button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/back"
            android:visibility="gone" />

        <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/library_title"
            android:textColor="@color/ink_black"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <Button
            android:id="@+id/library_button"
            style="@style/Widget.EInkWiki.Button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/library"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ink_black" />

    <TextView
        android:id="@+id/message_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/panel_border"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="48dp"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:textColor="@color/ink_black"
        android:textSize="16sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:animateLayoutChanges="false">

        <ScrollView
            android:id="@+id/library_screen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.25"
                    android:text="@string/library_intro"
                    android:textColor="@color/ink_black"
                    android:textSize="@dimen/text_body" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/panel_border"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pack_title"
                        android:textColor="@color/ink_black"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingMultiplier="1.2"
                        android:text="@string/pack_description"
                        android:textColor="@color/ink_black"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/pack_source"
                        android:textColor="@color/ink_gray"
                        android:textSize="@dimen/text_small" />

                    <TextView
                        android:id="@+id/storage_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:lineSpacingMultiplier="1.2"
                        android:textColor="@color/ink_black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <org.einkwiki.app.EInkProgressView
                        android:id="@+id/download_progress"
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:layout_marginTop="8dp"
                        android:contentDescription="@string/download_progress_description"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/download_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/ink_gray"
                        android:textSize="@dimen/text_small" />

                    <Button
                        android:id="@+id/download_button"
                        style="@style/Widget.EInkWiki.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/download_pack" />

                    <Button
                        android:id="@+id/open_search_button"
                        style="@style/Widget.EInkWiki.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/open_search"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/remove_pack_button"
                        style="@style/Widget.EInkWiki.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/remove_pack"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:lineSpacingMultiplier="1.2"
                    android:text="@string/pack_storage_note"
                    android:textColor="@color/ink_gray"
                    android:textSize="@dimen/text_small" />

                <LinearLayout
                    android:id="@+id/update_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/panel_border"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/updates_title"
                        android:textColor="@color/ink_black"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/current_version"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/ink_gray"
                        android:textSize="@dimen/text_small" />

                    <TextView
                        android:id="@+id/update_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingMultiplier="1.2"
                        android:textColor="@color/ink_black"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/update_button"
                        style="@style/Widget.EInkWiki.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/check_for_updates" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/search_screen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animateLayoutChanges="false"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/search_input"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/panel_border"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:importantForAutofill="no"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/ink_black"
                    android:textColorHint="@color/ink_gray"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/search_button"
                    style="@style/Widget.EInkWiki.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:text="@string/search_action" />
            </LinearLayout>

            <TextView
                android:id="@+id/search_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:text="@string/search_empty"
                android:textColor="@color/ink_gray"
                android:textSize="@dimen/text_small" />

            <ListView
                android:id="@+id/search_results"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:cacheColorHint="@color/paper_white"
                android:divider="@color/ink_black"
                android:dividerHeight="1dp"
                android:drawSelectorOnTop="false"
                android:listSelector="@drawable/list_selector"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:smoothScrollbar="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/reader_screen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animateLayoutChanges="false"
            android:orientation="vertical"
            android:visibility="gone">

            <WebView
                android:id="@+id/article_webview"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/paper_white"
                android:fadeScrollbars="false"
                android:overScrollMode="never"
                android:scrollbarStyle="outsideOverlay"
                android:scrollbars="none" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="6dp">

                <Button
                    android:id="@+id/page_up_button"
                    style="@style/Widget.EInkWiki.Button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/page_up" />

                <Button
                    android:id="@+id/font_smaller_button"
                    style="@style/Widget.EInkWiki.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:text="@string/font_smaller" />

                <Button
                    android:id="@+id/font_larger_button"
                    style="@style/Widget.EInkWiki.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:text="@string/font_larger" />

                <Button
                    android:id="@+id/page_down_button"
                    style="@style/Widget.EInkWiki.Button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/page_down" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
