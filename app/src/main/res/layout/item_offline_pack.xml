<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="false"
    android:background="@drawable/panel_border"
    android:focusable="false"
    android:minHeight="120dp"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="false"
        android:gravity="top"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/pack_row_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/ink_black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pack_row_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/panel_border"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textColor="@color/ink_black"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/pack_row_metadata"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/ink_gray"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/pack_row_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="2"
        android:textColor="@color/ink_black"
        android:textSize="16sp"
        android:textStyle="bold" />

    <org.einkwiki.app.EInkProgressView
        android:id="@+id/pack_row_progress"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/pack_row_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="3"
        android:textColor="@color/ink_gray"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/pack_row_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:animateLayoutChanges="false"
        android:orientation="horizontal">

        <Button
            android:id="@+id/pack_row_primary_action"
            style="@style/Widget.EInkWiki.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/pack_row_secondary_action"
            style="@style/Widget.EInkWiki.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:maxLines="2"
            android:minHeight="48dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
